STAGE_32_DESCRIPTION = "Hạm đội của chúng ta đã đến bờ biển Hammerhold mà không bị phát hiện. Tướng quân, trong khi súng của chúng tôi phá hủy tháp của họ, hãy đổ bộ và kiểm soát khu vực. Ngoài ra, hãy chuẩn bị trang phục đẹp nhất của tôi, chúng ta sẽ kết thúc một số huyền thoại."
STAGE_32_TITLE = "Nơi đổ bộ của phù thủy"
STAGE_33_DESCRIPTION = "Tsk, tsk, tôi không thể nói là tôi ấn tượng với bữa tiệc chào mừng được. Chúng ta đang xâm chiếm quê hương của họ và đây là sự phản kháng của họ? Nhưng chờ đã... đó có phải là chiếc Mirage nổi tiếng không? Tướng quân cảnh giác, nàng thích chơi bẩn, nên coi chừng phục kích và đánh lừa ảo tưởng."
STAGE_33_TITLE = "Ốc đảo Sape"
STAGE_34_DESCRIPTION = "Tướng quân, một số quân trinh sát của chúng tôi đã không trở về sau khi làm nhiệm vụ. Những người sống sót sợ hãi và mệt mỏi, lẩm bẩm về “những thứ” ẩn giấu bên trong kim tự tháp. Nếu có sức mạnh trong thung lũng, tôi muốn nó cho riêng mình, vì vậy tốt nhất bạn nên sẵn sàng điều tra."
STAGE_34_TITLE = "Đế chế đã mất"
STAGE_35_DESCRIPTION = "À, cánh cổng của Hammerhold. Tôi phải thừa nhận rằng chúng chắc chắn trông rất ấn tượng, nhưng chúng không thể sánh được với một quả cầu lửa được đặt đúng vị trí. Tôi ngạc nhiên khi Malik không đứng ở bức tường cùng quân của mình. Có vẻ như gần đây anh ấy đã trở nên tự mãn... như thể Denas là chưa đủ. Hãy chiếm lấy thành phố, Tướng quân!"
STAGE_35_TITLE = "Phố Hammerhold"
STAGE_36_DESCRIPTION = "Trong một tình tiết bất ngờ, Malik đã dám thách đấu tôi trong một trận đấu quyết định ở Đấu trường Hammerhold. Một truyền thống cổ xưa quy định rằng bất cứ ai chiến thắng trong Bài kiểm tra sa mạc sẽ được phong làm vua của thành phố. Không phải họ có quyền lựa chọn, nhưng bằng cách này tôi sẽ không phải dập tắt những cuộc nổi loạn phiền toái."
